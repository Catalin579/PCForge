# --- Supabase ---------------------------------------------------------------
# Local values are printed by `pnpm db:start` (supabase start).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection used by the seed script (`pnpm db:seed`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App ---------------------------------------------------------------------
# Public base URL, used for share links and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Region used when detection fails (ISO 3166-1 alpha-2, must exist in `regions`).
NEXT_PUBLIC_DEFAULT_REGION=RO
